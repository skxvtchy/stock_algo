# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase: Project Settings → API ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed to view Alpaca accounts and place orders.
ALLOWED_EMAILS=

# --- Alpaca paper account: app.alpaca.markets → Paper → API Keys -------------
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# --- Alpaca live account (optional) ------------------------------------------
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# The live account is view-only unless this is exactly "true".
ALPACA_LIVE_TRADING_ENABLED=false

# --- Daily auto-run (paper only) -----------------------------------------------
# Supabase secret key (Project Settings → API Keys → Secret keys). Server-only:
# lets the scheduler read auto-run schedules and log runs. Never expose it.
SUPABASE_SECRET_KEY=
# Shared secret Supabase Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
